{
  "manifest_version": 3,
  "name": "网页译读",
  "version": "0.1.0",
  "description": "主动翻译当前网页和选区，支持双语、仅译文与还原。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页译读"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "sidebar_action": {
    "default_title": "翻译与写作工作台",
    "default_panel": "workbench.html?sidebar=1",
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-reader@browser-fanyi.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  }
}
